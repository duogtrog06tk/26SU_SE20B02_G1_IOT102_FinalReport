# Cấu hình tài khoản Firebase Admin SDK (Tải file JSON từ Firebase Console)
# Đặt tên file json tải về thành "serviceAccountKey.json" và để cùng thư mục với app.py

# Cấu hình Database URL (Dành cho bản REST API khi Firebase Admin bị lỗi quyền)
# FIREBASE_DB_URL=https://<your-project-id>.firebaseio.com/

